pipeline {
    agent { label 'agent-1 || agent-2' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    triggers {
        cron('H/5 * * * *')
    }

    environment {
        VENV_DIR      = '.venv'
        REPORTS_DIR   = 'reports'
        ARTIFACTS_DIR = 'artifacts'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                sh '''
                    set -eux
                    echo "=== Environment Check ==="
                    whoami
                    pwd
                    uname -a || true
                    which python3
                    python3 --version
                    python3 -m pip --version || true
                '''
            }
        }

        stage('Test JDK Tool') {
            steps {
                script {
                    def jdkHome = tool name: 'jdk17-test', type: 'hudson.model.JDK'
                    env.JAVA_HOME = jdkHome
                    env.PATH = "${jdkHome}/bin:${env.PATH}"
                }
                sh '''
                    set -eux
                    echo "=== JDK Tool Check ==="
                    echo "JAVA_HOME=$JAVA_HOME"
                    which java
                    java -version
                    javac -version
                '''
            }
        }

        stage('Setup Python') {
            steps {
                sh '''
                    set -eux

                    rm -rf "${VENV_DIR}"

                    python3 -m venv "${VENV_DIR}" || {
                        echo "ERROR: Agent thiếu gói python3-venv (hoặc python3.13-venv)."
                        echo "Hãy cài vào image agent trước khi chạy lại pipeline."
                        exit 1
                    }

                    . "${VENV_DIR}/bin/activate"
                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        echo "No requirements.txt found, skipping dependency file install."
                    fi

                    pip install pytest pytest-html flake8
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    set +e

                    mkdir -p "${REPORTS_DIR}"
                    . "${VENV_DIR}/bin/activate"

                    flake8 . \
                      --exclude=.git,__pycache__,.venv,reports,artifacts \
                      --output-file="${REPORTS_DIR}/flake8-report.txt"

                    exit 0
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    set -eux

                    mkdir -p "${REPORTS_DIR}"
                    . "${VENV_DIR}/bin/activate"

                    if [ -d tests ]; then
                        pytest tests -q \
                          --junitxml="${REPORTS_DIR}/junit.xml" \
                          --html="${REPORTS_DIR}/pytest-report.html" \
                          --self-contained-html
                    else
                        cat > test_smoke.py <<'EOF'
def test_basic():
    assert 1 + 1 == 2
EOF
                        pytest test_smoke.py -q \
                          --junitxml="${REPORTS_DIR}/junit.xml" \
                          --html="${REPORTS_DIR}/pytest-report.html" \
                          --self-contained-html
                    fi
                '''
            }
        }

        stage('Package Info') {
            steps {
                sh '''
                    set -eux

                    mkdir -p "${ARTIFACTS_DIR}"

                    {
                        echo "Build Number: ${BUILD_NUMBER}"
                        echo "Job Name: ${JOB_NAME}"
                        echo "Branch Name: ${BRANCH_NAME:-main}"
                        echo "Node Name: ${NODE_NAME}"
                        echo "Workspace: ${WORKSPACE}"
                        git rev-parse --short HEAD || true
                        date
                    } > "${ARTIFACTS_DIR}/build-info.txt"
                '''
            }
        }
    }

    post {
        always {
            junit testResults: "${REPORTS_DIR}/junit.xml", allowEmptyResults: true

            publishHTML(target: [
                reportName: 'Pytest HTML Report',
                reportDir: "${REPORTS_DIR}",
                reportFiles: 'pytest-report.html',
                keepAll: true,
                allowMissing: true,
                alwaysLinkToLastBuild: true
            ])

            recordIssues tools: [flake8(pattern: "${REPORTS_DIR}/flake8-report.txt")]

            archiveArtifacts artifacts: "${ARTIFACTS_DIR}/**, ${REPORTS_DIR}/**",
                             allowEmptyArchive: true,
                             fingerprint: true
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the first error in Console Output.'
        }
    }
}
