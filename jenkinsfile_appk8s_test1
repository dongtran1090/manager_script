pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins
spec:
  serviceAccountName: jenkins-agent-admin
  securityContext:
    runAsUser: 1000
    fsGroup: 1000
  containers:
  - name: kubectl
    image: bitnami/kubectl:latest
    command:
    - /bin/sh
    - -c
    args:
    - sleep 99d
    tty: true
    securityContext:
      runAsUser: 1000
'''
    }
  }

  environment {
    APP_NAMESPACE = 'demo-test1'
    APP_DEPLOYMENT = 'appk8s-test1'
    K8S_DIR = 'k8s/appk8s_test1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Deploy') {
      steps {
        container('kubectl') {
          sh '''
            APISERVER="https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT_HTTPS}"
            TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
            CACERT="/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
            K="kubectl --server=$APISERVER --token=$TOKEN --certificate-authority=$CACERT"

            $K apply -f ${K8S_DIR}/namespace.yaml
            $K apply -f ${K8S_DIR}/deployment.yaml
            $K apply -f ${K8S_DIR}/service.yaml
            $K rollout status deployment/${APP_DEPLOYMENT} -n ${APP_NAMESPACE} --timeout=120s
          '''
        }
      }
    }

    stage('Verify') {
      steps {
        container('kubectl') {
          sh '''
            APISERVER="https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT_HTTPS}"
            TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
            CACERT="/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
            K="kubectl --server=$APISERVER --token=$TOKEN --certificate-authority=$CACERT"

            $K get deploy -n ${APP_NAMESPACE}
            $K get pods -n ${APP_NAMESPACE}
            $K get svc -n ${APP_NAMESPACE}
          '''
        }
      }
    }
  }
}