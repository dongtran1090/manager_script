pipeline {
    agent { label 'agent-1' }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        KUBECONFIG = '/root/.kube/proxy-config'
        K8S_NAMESPACE = 'demo'
        DEPLOYMENT_NAME = 'demo-app'
        EMAIL_TO = 'tvdtphcm1812@gmail.com'
    }

    stages {
        stage('Notify Before Build') {
            steps {
                emailext(
                    to: "${EMAIL_TO}",
                    subject: "[Jenkins] ${env.JOB_NAME} #${env.BUILD_NUMBER} K8S test will start in 10 seconds",
                    body: """Jenkins is about to run the K8S test job.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Triggered at: ${new Date()}
URL: ${env.BUILD_URL}
"""
                )
                sleep time: 10, unit: 'SECONDS'
            }
        }

        stage('Checkout Source') {
            steps {
                checkout scm
                sh '''
                    echo "===== WORKSPACE ====="
                    pwd
                    echo "===== ROOT FILES ====="
                    ls -la
                    echo "===== K8S FILES ====="
                    ls -la k8s
                    echo "===== namespace.yaml ====="
                    cat k8s/namespace.yaml
                    echo "===== deployment.yaml ====="
                    cat k8s/deployment.yaml
                    echo "===== service.yaml ====="
                    cat k8s/service.yaml
                '''
            }
        }

        stage('Check Python Script') {
            steps {
                sh '''
                    python3 --version
                    ls -la script_now.py
                '''
            }
        }

        stage('Run Script Now') {
            steps {
                sh 'python3 script_now.py'
            }
        }

        stage('Check Kubernetes') {
            steps {
                sh '''
                    echo "KUBECONFIG=$KUBECONFIG"
                    kubectl config current-context
                    kubectl get nodes
                    kubectl get ns
                '''
            }
        }

        stage('Apply Namespace') {
            steps {
                sh 'kubectl apply -f k8s/namespace.yaml'
            }
        }

        stage('Wait Namespace Ready') {
            steps {
                sh '''
                    for i in $(seq 1 15); do
                      kubectl get ns ${K8S_NAMESPACE} >/dev/null 2>&1 && break
                      echo "Waiting namespace ${K8S_NAMESPACE}..."
                      sleep 2
                    done

                    kubectl get ns ${K8S_NAMESPACE}
                '''
            }
        }

        stage('Apply Deployment') {
            steps {
                sh 'kubectl apply -f k8s/deployment.yaml'
            }
        }

        stage('Apply Service') {
            steps {
                sh 'kubectl apply -f k8s/service.yaml'
            }
        }

        stage('Wait Rollout') {
            steps {
                sh 'kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${K8S_NAMESPACE} --timeout=120s'
            }
        }

        stage('Verify K8s Resources') {
            steps {
                sh '''
                    echo "===== DEPLOYMENT ====="
                    kubectl get deploy -n ${K8S_NAMESPACE}

                    echo "===== PODS ====="
                    kubectl get pods -n ${K8S_NAMESPACE} -o wide

                    echo "===== SERVICES ====="
                    kubectl get svc -n ${K8S_NAMESPACE}

                    echo "===== ALL ====="
                    kubectl get all -n ${K8S_NAMESPACE}
                '''
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "[SUCCESS] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """K8S test completed successfully.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Namespace: ${env.K8S_NAMESPACE}
Deployment: ${env.DEPLOYMENT_NAME}
Finished at: ${new Date()}
URL: ${env.BUILD_URL}
"""
            )
        }

        failure {
            sh '''
                echo "===== DEBUG: NAMESPACE ====="
                kubectl get ns || true

                echo "===== DEBUG: DEPLOYMENT ====="
                kubectl get deploy -A || true

                echo "===== DEBUG: PODS ====="
                kubectl get pods -A || true

                echo "===== DEBUG: SERVICE ====="
                kubectl get svc -A || true

                echo "===== DEBUG: DESCRIBE DEPLOYMENT ====="
                kubectl describe deployment ${DEPLOYMENT_NAME} -n ${K8S_NAMESPACE} || true

                echo "===== DEBUG: DESCRIBE PODS ====="
                kubectl describe pod -n ${K8S_NAMESPACE} || true
            '''

            emailext(
                to: "${EMAIL_TO}",
                subject: "[FAILURE] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """K8S test failed.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Namespace: ${env.K8S_NAMESPACE}
Deployment: ${env.DEPLOYMENT_NAME}
Finished at: ${new Date()}
URL: ${env.BUILD_URL}
Please check Console Output in Jenkins.
"""
            )
        }
    }
}