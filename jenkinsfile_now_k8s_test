pipeline {
    agent { label 'agent-1' }

    stages {
        stage('Notify Before Build') {
            steps {
                emailext(
                    to: 'tvdtphcm1812@gmail.com',
                    subject: "[Jenkins] ${env.JOB_NAME} #${env.BUILD_NUMBER} K8S test will start in 10 seconds",
                    body: """Jenkins is about to run the K8S test job.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Triggered at: ${new Date()}
URL: ${env.BUILD_URL}
"""
                )
                sleep time: 10, unit: 'SECONDS'
            }
        }

        stage('Checkout Source') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la k8s'
                sh 'cat k8s/namespace.yaml'
                sh 'echo "---"'
                sh 'cat k8s/deployment.yaml'
                sh 'echo "---"'
                sh 'cat k8s/service.yaml'
            }
        }

        stage('Check Kubernetes') {
            steps {
                sh 'echo $KUBECONFIG'
                sh 'kubectl config current-context'
                sh 'kubectl get nodes'
                sh 'kubectl get ns'
            }
        }

        stage('Apply Namespace') {
            steps {
                sh 'kubectl apply -f k8s/namespace.yaml'
            }
        }

        stage('Wait Namespace Ready') {
            steps {
                sh '''
                    for i in $(seq 1 30); do
                      kubectl get ns demo >/dev/null 2>&1 && break
                      sleep 2
                    done
                    kubectl get ns demo
                '''
            }
        }

        stage('Apply Deployment') {
            steps {
                sh 'kubectl apply -f k8s/deployment.yaml'
            }
        }

        stage('Apply Service') {
            steps {
                sh 'kubectl apply -f k8s/service.yaml'
            }
        }

        stage('Wait Rollout') {
            steps {
                sh 'kubectl rollout status deployment/demo-app -n demo --timeout=120s'
            }
        }

        stage('Verify K8s Resources') {
            steps {
                sh 'kubectl get deploy -A'
                sh 'kubectl get pods -A'
                sh 'kubectl get svc -A'
            }
        }
    }

    post {
        success {
            emailext(
                to: 'tvdtphcm1812@gmail.com',
                subject: "[SUCCESS] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """K8S test completed successfully.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Finished at: ${new Date()}
URL: ${env.BUILD_URL}
"""
            )
        }
        failure {
            emailext(
                to: 'tvdtphcm1812@gmail.com',
                subject: "[FAILURE] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """K8S test failed.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Finished at: ${new Date()}
URL: ${env.BUILD_URL}
"""
            )
        }
    }
}
