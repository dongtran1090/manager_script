stage('Apply Namespace') {
    steps {
        sh 'kubectl apply -f k8s/namespace.yaml'
    }
}

stage('Wait Namespace Ready') {
    steps {
        sh '''
            for i in $(seq 1 10); do
              kubectl get ns demo >/dev/null 2>&1 && break
              sleep 2
            done
            kubectl get ns demo
        '''
    }
}

stage('Apply Deployment') {
    steps {
        sh 'kubectl apply -f k8s/deployment.yaml'
    }
}

stage('Apply Service') {
    steps {
        sh 'kubectl apply -f k8s/service.yaml'
    }
}

stage('Wait Rollout') {
    steps {
        sh 'kubectl rollout status deployment/demo-app -n demo --timeout=120s'
    }
}

stage('Verify K8s Resources') {
    steps {
        sh 'kubectl get deploy -n demo'
        sh 'kubectl get pods -n demo'
        sh 'kubectl get svc -n demo'
    }
}
