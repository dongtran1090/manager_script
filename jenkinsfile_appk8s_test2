pipeline {
    agent { label 'agent-1' }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        KUBECONFIG = '/root/.kube/proxy-config'
        K8S_NAMESPACE = 'demo-test2'
        DEPLOYMENT_NAME = 'appk8s-test2'
        SERVICE_NAME = 'appk8s-test2'
        K8S_DIR = 'k8s/appk8s_test2'
    }

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la ${K8S_DIR}'
            }
        }

        stage('Check Kubernetes') {
            steps {
                sh 'echo $KUBECONFIG'
                sh 'kubectl config current-context'
                sh 'kubectl get nodes'
            }
        }

        stage('Apply Namespace') {
            steps {
                sh 'kubectl apply -f ${K8S_DIR}/namespace.yaml'
            }
        }

        stage('Wait Namespace Ready') {
            steps {
                sh '''
                    for i in $(seq 1 15); do
                      kubectl get ns ${K8S_NAMESPACE} >/dev/null 2>&1 && break
                      sleep 2
                    done
                    kubectl get ns ${K8S_NAMESPACE}
                '''
            }
        }

        stage('Apply Deployment') {
            steps {
                sh 'kubectl apply -f ${K8S_DIR}/deployment.yaml'
            }
        }

        stage('Apply Service') {
            steps {
                sh 'kubectl apply -f ${K8S_DIR}/service.yaml'
            }
        }

        stage('Wait Rollout') {
            steps {
                sh 'kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${K8S_NAMESPACE} --timeout=120s'
            }
        }

        stage('Verify') {
            steps {
                sh 'kubectl get deploy -n ${K8S_NAMESPACE}'
                sh 'kubectl get pods -n ${K8S_NAMESPACE} -o wide'
                sh 'kubectl get svc -n ${K8S_NAMESPACE}'
            }
        }
    }
}