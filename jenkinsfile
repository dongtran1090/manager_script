pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
    }

   

    stages {
        stage('Run agents in parallel') {
            parallel {
                stage('Task on agent-1') {
                    agent { label 'agent-1' }

                    environment {
                        TASK_NAME   = 'nv-1'
                        TARGET_FILE = 'script_now.py'
                    }

                    steps {
                        lock(resource: 'central-history-log') {
                            sh '''
                                SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=STARTED | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                            '''
                        }

                        sh '''
                            echo "agent-1 dang chay ${TARGET_FILE}"
                            sleep 5
                            # python3 ${TARGET_FILE}
                        '''
                    }

                    post {
                        success {
                            lock(resource: 'central-history-log') {
                                sh '''
                                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                    mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                    echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=SUCCESS | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                                '''
                            }
                        }
                        failure {
                            lock(resource: 'central-history-log') {
                                sh '''
                                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                    mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                    echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=FAILURE | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                                '''
                            }
                        }
                    }
                }

                stage('Task on agent-2') {
                    agent { label 'agent-2' }

                    environment {
                        TASK_NAME   = 'nv-2'
                        TARGET_FILE = 'script_run_5m.py'
                    }

                    steps {
                        lock(resource: 'central-history-log') {
                            sh '''
                                SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=STARTED | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                            '''
                        }

                        sh '''
                            echo "agent-2 dang chay ${TARGET_FILE}"
                            sleep 7
                            # python3 ${TARGET_FILE}
                        '''
                    }

                    post {
                        success {
                            lock(resource: 'central-history-log') {
                                sh '''
                                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                    mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                    echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=SUCCESS | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                                '''
                            }
                        }
                        failure {
                            lock(resource: 'central-history-log') {
                                sh '''
                                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                                    mkdir -p "/shared-logs/$SAFE_JOB_NAME"
                                    echo "$(date '+%Y-%m-%d %H:%M:%S') | BUILD=#${BUILD_NUMBER} | AGENT=${NODE_NAME} | STATUS=FAILURE | TASK=${TASK_NAME} | FILE=${TARGET_FILE}" >> "/shared-logs/$SAFE_JOB_NAME/history.log"
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Show central history log') {
            agent { label 'built-in' }
            steps {
                sh '''
                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                    echo "===== CENTRAL HISTORY LOG ====="
                    cat "/shared-logs/$SAFE_JOB_NAME/history.log"
                '''
            }
        }

        stage('Archive current history snapshot') {
            agent { label 'built-in' }
            steps {
                deleteDir()
                sh '''
                    SAFE_JOB_NAME=$(echo "$JOB_NAME" | tr '/' '_')
                    mkdir -p final_logs
                    cp "/shared-logs/$SAFE_JOB_NAME/history.log" final_logs/history.log
                '''
                archiveArtifacts artifacts: 'final_logs/history.log', fingerprint: true
            }
        }
    }
}
