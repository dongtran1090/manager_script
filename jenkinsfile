pipeline {
    agent none

    triggers {
        cron('H/5 * * * *')
    }

    stages {
        stage('Run agents in parallel') {
            parallel {
                stage('Task on agent-1') {
                    agent { label 'agent-1' }
                    steps {
                        sh '''
                            mkdir -p reports
                            echo "[`date '+%Y-%m-%d %H:%M:%S'`] [agent-1] bat dau task 1"
                            sleep 5
                            echo "[`date '+%Y-%m-%d %H:%M:%S'`] [agent-1] da xong nv 1" > reports/agent-1.log
                        '''
                        stash name: 'agent1-log', includes: 'reports/agent-1.log'
                    }
                }

                stage('Task on agent-2') {
                    agent { label 'agent-2' }
                    steps {
                        sh '''
                            mkdir -p reports
                            echo "[`date '+%Y-%m-%d %H:%M:%S'`] [agent-2] bat dau task 2"
                            sleep 7
                            echo "[`date '+%Y-%m-%d %H:%M:%S'`] [agent-2] da xong nv 2" > reports/agent-2.log
                        '''
                        stash name: 'agent2-log', includes: 'reports/agent-2.log'
                    }
                }
            }
        }

        stage('Collect logs on main build node') {
            agent { label 'built-in' }
            steps {
                script {
                    env.SAFE_JOB_NAME = env.JOB_NAME.replace('/', '_')
                }

                deleteDir()
                unstash 'agent1-log'
                unstash 'agent2-log'

                sh '''
                    mkdir -p final_logs
                    mkdir -p /var/jenkins_home/custom_logs/${SAFE_JOB_NAME}

                    BUILD_LOG="final_logs/summary-${BUILD_NUMBER}.log"
                    HISTORY_LOG="/var/jenkins_home/custom_logs/${SAFE_JOB_NAME}/history.log"

                    {
                        echo "=================================================="
                        echo "JOB   : ${JOB_NAME}"
                        echo "BUILD : #${BUILD_NUMBER}"
                        echo "TIME  : $(date '+%Y-%m-%d %H:%M:%S')"
                        echo "=================================================="
                        cat reports/agent-1.log
                        cat reports/agent-2.log
                        echo
                    } > "$BUILD_LOG"

                    cat "$BUILD_LOG" >> "$HISTORY_LOG"

                    cp "$HISTORY_LOG" final_logs/history.log
                '''

                echo '===== BUILD LOG ====='
                sh 'cat final_logs/summary-${BUILD_NUMBER}.log'

                echo '===== HISTORY LOG ====='
                sh 'cat final_logs/history.log'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'final_logs/*.log', fingerprint: true
                }
            }
        }
    }
}
